      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "description": "Manage your wedding website"
    },
    {
      "name": "Create site",
      "short_name": "Create",
      "url": "/wizard",
      "description": "Start a new wedding website"
    },
    {
      "name": "Templates",
      "short_name": "Templates",
      "url": "/templates",
      "description": "Browse premium templates"
    }
  ]
}